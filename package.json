{
  "name": "@temet-ai/ask-kit",
  "version": "0.6.1",
  "mcpName": "io.github.temet-ai/ask-kit",
  "description": "One plain-language `ask` tool for coding agents: a cheap model with a REPL and scripts answers about your past sessions and your code, outside your agent's context.",
  "keywords": [
    "mcp",
    "mcp-server",
    "claude-code",
    "codex",
    "copilot",
    "gemini-cli",
    "opencode",
    "coding-agents",
    "context",
    "context-window",
    "context-engineering",
    "token-optimization",
    "code-mode",
    "transcripts",
    "code-search",
    "repl"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Dawid du Toit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temet-ai/ask-kit.git"
  },
  "homepage": "https://github.com/temet-ai/ask-kit#readme",
  "bugs": "https://github.com/temet-ai/ask-kit/issues",
  "bin": {
    "ask-kit": "bin/ask-kit.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "test:machine": "node test/adapters.mjs"
  },
  "files": [
    "bin",
    "src",
    "domains",
    "kits",
    "bundle",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@vscode/ripgrep": "1.18.0",
    "acorn": "8.19.0",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  }
}
