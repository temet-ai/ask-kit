{
  "name": "ask-kit",
  "displayName": "ask-kit",
  "version": "0.6.0",
  "description": "One plain-language `ask` tool: a cheap model with a REPL and scripts answers about your past sessions, your code and any kit you add, outside your agent's context.",
  "author": {
    "name": "Dawid du Toit",
    "url": "https://github.com/temet-ai"
  },
  "homepage": "https://github.com/temet-ai/ask-kit#readme",
  "repository": "https://github.com/temet-ai/ask-kit",
  "license": "MIT",
  "keywords": [
    "ask",
    "mcp",
    "transcripts",
    "sessions",
    "code search",
    "kits"
  ],
  "skills": [
    "./plugin/skills/"
  ],
  "agents": [
    "./plugin/agents/ask-kit-tuner.md"
  ],
  "mcpServers": {
    "ask": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/ask-kit.mjs",
        "serve"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/ask-kit.mjs",
              "plugin",
              "start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/ask-kit.mjs",
              "plugin",
              "tool"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/ask-kit.mjs",
              "plugin",
              "subagent"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
